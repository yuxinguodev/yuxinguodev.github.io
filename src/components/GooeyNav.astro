---
/*
 * Gooey navigation: the active item is a white pill that splits into
 * droplets and flows to the newly chosen item.
 *
 * Ported to a framework-free Astro component from GooeyNav in React Bits
 * (https://reactbits.dev/c/components/gooey-nav, https://github.com/DavidHDev/react-bits).
 *
 * Copyright (c) 2026 David Haz
 * Licensed under MIT + Commons Clause License Condition v1.0: free to use,
 * modify and publish as part of an application, website or product; the
 * above copyright notice and this permission notice must be included; the
 * component itself may not be sold, sublicensed or redistributed on its own.
 */

interface Item {
	label: string;
	href: string;
}

interface Props {
	items: Item[];
}

const { items } = Astro.props;

// Which item matches the current URL (e.g. /projects/foo -> "/projects").
const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '/');
const first = '/' + (pathname.match(/[^/]+/)?.[0] ?? '');
const active = Math.max(0, items.findIndex((item) => item.href === first || item.href === pathname));
---

<nav class="gooey-nav" aria-label="Main" data-active={active}>
	<span class="rim" aria-hidden="true"></span>
	<div class="stage">
		<canvas class="canvas" aria-hidden="true"></canvas>
		<span class="fallback" aria-hidden="true"></span>
		<ul class="list">
			{items.map((item, i) => (
				<li class="item" data-gooey-index={i} data-active={i === active ? '' : undefined}>
					<a class="link" href={item.href} aria-current={i === active ? 'page' : undefined}>{item.label}</a>
				</li>
			))}
		</ul>
		<!-- Same labels in dark ink, clipped to the white pill's shape. -->
		<ul class="list list--active" aria-hidden="true">
			{items.map((item) => (
				<li class="item"><span class="link">{item.label}</span></li>
			))}
		</ul>
	</div>
</nav>

<style>
	.gooey-nav {
		--pad: 6px;
		--gap: 4px;
		--frame: rgba(38, 35, 46, 0.66);
		--frame-edge: rgba(255, 255, 255, 0.08);
		--frame-highlight: rgba(255, 255, 255, 0.07);
		--ink: #f4f4f5;
		--muted: rgba(244, 244, 245, 0.62);
		--pill: #f4f4f5;
		--active-ink: #18161d;
		position: relative;
		display: inline-flex;
		max-width: 100%;
		padding: var(--pad);
		font-size: 15px;
		line-height: 1.2;
		border-radius: 999px;
		background: var(--frame);
		box-shadow:
			0 22px 44px -20px rgba(0, 0, 0, 0.8),
			0 6px 16px -8px rgba(0, 0, 0, 0.5);
		-webkit-backdrop-filter: blur(20px) saturate(1.6);
		backdrop-filter: blur(20px) saturate(1.6);
	}
	.rim {
		position: absolute;
		inset: 0;
		border-radius: inherit;
		box-shadow:
			inset 0 0 0 1px var(--frame-edge),
			inset 0 1px 0 var(--frame-highlight);
		pointer-events: none;
	}
	.stage {
		position: relative;
		max-width: 100%;
	}
	.canvas {
		position: absolute;
		top: 0;
		left: 0;
		pointer-events: none;
	}
	.fallback {
		position: absolute;
		top: 0;
		left: 0;
		display: none;
		border-radius: 999px;
		background: var(--pill);
		pointer-events: none;
	}
	.list {
		position: relative;
		display: flex;
		gap: var(--gap);
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.list--active {
		position: absolute;
		inset: 0;
		color: var(--active-ink);
		visibility: hidden;
		clip-path: inset(100%);
		pointer-events: none;
	}
	.item {
		display: flex;
	}
	.link {
		display: inline-flex;
		align-items: center;
		padding: 9px 18px;
		border-radius: 999px;
		color: var(--muted);
		font: inherit;
		font-weight: 500;
		text-decoration: none;
		white-space: nowrap;
		transition: color 0.2s ease;
		-webkit-tap-highlight-color: transparent;
	}
	.list--active .link {
		color: inherit;
	}
	.item[data-active] .link {
		color: var(--ink);
	}
	.link:focus-visible {
		outline: 2px solid var(--ink);
		outline-offset: 2px;
	}
	@media (hover: hover) {
		.link:hover {
			color: var(--ink);
		}
	}
	@media (max-width: 480px) {
		.link {
			padding: 8px 12px;
			font-size: 14px;
		}
	}
</style>

<script>
	// ---- Settings (React Bits defaults, dark theme) ----
	const ANIMATION_TIME = 600;
	const PARTICLE_COUNT = 15;
	const TIME_VARIANCE = 300;
	const SPREAD = 56;
	const GOOEYNESS = 0.5;
	const WOBBLE = 0.5;
	const PILL_RGB = [244 / 255, 244 / 255, 245 / 255];
	const HOVER_RGBA = [1, 1, 1, 0.08];
	const SHADOW = 0.4;
	const NAVIGATE_DELAY = 520; // let the flow play before following the link

	const MAX_DROPS = 32;
	const MAX_PILLS = 4;
	const MARGIN = 72;

	const VERTEX = `#version 300 es
in vec2 aPosition;
void main() { gl_Position = vec4(aPosition, 0.0, 1.0); }
`;

	// Signed-distance field of pills and droplets, smoothly unioned ("goo").
	const FRAGMENT = `#version 300 es
precision highp float;
uniform vec2 uSize;
uniform float uRatio;
uniform vec4 uPills[${MAX_PILLS}];
uniform vec4 uHover;
uniform vec4 uDrops[${MAX_DROPS}];
uniform vec2 uTails[${MAX_DROPS}];
uniform vec3 uTints[${MAX_DROPS}];
uniform int uCount;
uniform float uSmooth;
uniform vec3 uPill;
uniform vec4 uHoverColor;
uniform float uShadow;
out vec4 outColor;

float sdPill(vec2 p, vec4 box) {
  vec2 extent = max(box.zw, vec2(0.0));
  float r = min(extent.x, extent.y);
  vec2 q = abs(p - box.xy) - extent + r;
  return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r;
}
float sdCapsule(vec2 p, vec2 a, vec2 b, float r) {
  vec2 pa = p - a, ba = b - a;
  float h = clamp(dot(pa, ba) / max(dot(ba, ba), 0.0001), 0.0, 1.0);
  return length(pa - ba * h) - r;
}
vec4 blend(vec4 a, vec4 b, float k) {
  float h = clamp(0.5 + 0.5 * (b.w - a.w) / k, 0.0, 1.0);
  return vec4(mix(b.rgb, a.rgb, h), mix(b.w, a.w, h) - k * h * (1.0 - h));
}
vec4 field(vec2 p) {
  vec4 shape = vec4(uPill, 1e5);
  for (int i = 0; i < ${MAX_PILLS}; i++) {
    vec4 pill = uPills[i];
    if (pill.z <= 0.0) continue;
    shape = blend(shape, vec4(uPill, sdPill(p, pill)), uSmooth);
  }
  for (int i = 0; i < ${MAX_DROPS}; i++) {
    if (i >= uCount) break;
    vec4 drop = uDrops[i];
    if (drop.z <= 0.0) continue;
    float d = sdCapsule(p, drop.xy, drop.xy - uTails[i], drop.z);
    if (d > shape.w + uSmooth) continue;
    shape = blend(shape, vec4(uTints[i], d), uSmooth);
  }
  return shape;
}
void main() {
  vec2 p = vec2(gl_FragCoord.x, uSize.y * uRatio - gl_FragCoord.y) / uRatio;
  vec4 shape = field(p);
  float d = shape.w;
  float aa = max(fwidth(d), 0.35);
  float body = clamp(0.5 - d / aa, 0.0, 1.0);
  vec2 grad = vec2(dFdx(d), -dFdy(d));
  vec2 n = length(grad) > 0.0001 ? normalize(grad) : vec2(0.0, 1.0);
  float rim = (1.0 - smoothstep(0.0, 1.6, -d)) * max(0.0, -n.y) * 0.3;
  vec3 fill = mix(shape.rgb, vec3(1.0), rim) * (1.0 - 0.06 * max(0.0, n.y) * (1.0 - smoothstep(0.0, 6.0, -d)));
  float lifted = field(p - vec2(0.0, 3.0)).w;
  float shadow = (1.0 - smoothstep(-3.0, 9.0, lifted)) * uShadow * (1.0 - body);
  float hover = clamp(0.5 - sdPill(p, uHover) / aa, 0.0, 1.0) * uHoverColor.a;
  vec4 color = vec4(0.0, 0.0, 0.0, shadow);
  color = vec4(uHoverColor.rgb * hover, hover) + color * (1.0 - hover);
  color = vec4(fill * body, body) + color * (1.0 - body);
  outColor = color;
}
`;

	type Rect = { x: number; y: number; w: number; h: number };
	type Pill = { mass: number; scale: number; velocity: number; outgoing: number };
	type Drop = {
		x: number; y: number; vx: number; vy: number; mass: number; size: number; given: number;
		source: number; index: number; leave: number; emerged: number; absorbed: number;
		state: 'waiting' | 'flying' | 'absorbing'; start?: number; duration?: number; path?: number[];
	};

	const clamp01 = (v: number) => Math.min(1, Math.max(0, v));
	const travelEase = (t: number) => {
		const x = clamp01(t);
		return x < 0.5 ? 4 * x * x * x : 1 - (-2 * x + 2) ** 3 / 2;
	};
	const bezier = (a: number, b: number, c: number, d: number, t: number) => {
		const u = 1 - t;
		return u * u * u * a + 3 * u * u * t * b + 3 * u * t * t * c + t * t * t * d;
	};
	const pillPath = (x: number, y: number, w: number, h: number) => {
		if (w <= 0.5 || h <= 0.5) return '';
		const r = Math.min(w, h) / 2;
		return `M${x + r},${y}H${x + w - r}A${r},${r} 0 0 1 ${x + w},${y + r}V${y + h - r}A${r},${r} 0 0 1 ${x + w - r},${y + h}H${x + r}A${r},${r} 0 0 1 ${x},${y + h - r}V${y + r}A${r},${r} 0 0 1 ${x + r},${y}Z`;
	};

	function setup(nav: HTMLElement) {
		const stage = nav.querySelector<HTMLElement>('.stage')!;
		const canvas = nav.querySelector<HTMLCanvasElement>('.canvas')!;
		const list = nav.querySelector<HTMLElement>('.list:not(.list--active)')!;
		const overlay = nav.querySelector<HTMLElement>('.list--active')!;
		const fallback = nav.querySelector<HTMLElement>('.fallback')!;
		const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		// ---- WebGL pipeline (falls back to a plain CSS pill) ----
		const gl = canvas.getContext('webgl2', { alpha: true, premultipliedAlpha: true, antialias: false });
		let pipeline: { program: WebGLProgram; u: Record<string, WebGLUniformLocation | null>; buffer: WebGLBuffer; position: number } | null = null;
		if (gl) {
			const compile = (type: number, src: string) => {
				const s = gl.createShader(type)!;
				gl.shaderSource(s, src);
				gl.compileShader(s);
				return s;
			};
			const program = gl.createProgram()!;
			gl.attachShader(program, compile(gl.VERTEX_SHADER, VERTEX));
			gl.attachShader(program, compile(gl.FRAGMENT_SHADER, FRAGMENT));
			gl.linkProgram(program);
			if (gl.getProgramParameter(program, gl.LINK_STATUS)) {
				const names = ['uSize', 'uRatio', 'uPills', 'uHover', 'uDrops', 'uTails', 'uTints', 'uCount', 'uSmooth', 'uPill', 'uHoverColor', 'uShadow'];
				const u = Object.fromEntries(names.map((n) => [n, gl.getUniformLocation(program, n)]));
				const buffer = gl.createBuffer()!;
				gl.bindBuffer(gl.ARRAY_BUFFER, buffer);
				gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
				pipeline = { program, u, buffer, position: gl.getAttribLocation(program, 'aPosition') };
			}
		}
		fallback.style.display = pipeline ? 'none' : 'block';
		canvas.style.display = pipeline ? 'block' : 'none';

		const view = { width: 0, height: 0 };
		let rects: Rect[] = [];
		let target = -1;
		const pills = new Map<number, Pill>();
		const drops: Drop[] = [];
		const hover = { x: 0, y: 0, w: 0, h: 0, alpha: 0, index: -1 };
		const pillData = new Float32Array(MAX_PILLS * 4);
		const dropData = new Float32Array(MAX_DROPS * 4);
		const tailData = new Float32Array(MAX_DROPS * 2);
		const tintData = new Float32Array(MAX_DROPS * 3);
		let raf = 0;
		let last = 0;

		const measure = () => {
			const box = stage.getBoundingClientRect();
			const ratio = Math.min(window.devicePixelRatio || 1, 2);
			view.width = box.width;
			view.height = box.height;
			const ow = box.width + MARGIN * 2;
			const oh = box.height + MARGIN * 2;
			Object.assign(canvas.style, { left: `${-MARGIN}px`, top: `${-MARGIN}px`, width: `${ow}px`, height: `${oh}px` });
			const w = Math.max(1, Math.round(ow * ratio));
			const h = Math.max(1, Math.round(oh * ratio));
			if (canvas.width !== w || canvas.height !== h) {
				canvas.width = w;
				canvas.height = h;
			}
			rects = Array.from(list.children).map((item) => {
				const r = item.getBoundingClientRect();
				return { x: r.left - box.left, y: r.top - box.top, w: r.width, h: r.height };
			});
		};

		// Rasterise the gooey shape into an SVG path so the dark labels can be
		// clipped to exactly where the white pill is.
		type Box = { cx: number; cy: number; hw: number; hh: number };
		type Blob = { x: number; y: number; r: number; tx: number; ty: number };
		const trace = (boxes: Box[], blobs: Blob[], smooth: number) => {
			const field = (x: number, y: number) => {
				let d = 1e5;
				const merge = (value: number) => {
					const h = clamp01(0.5 + (0.5 * (value - d)) / smooth);
					d = value + (d - value) * h - smooth * h * (1 - h);
				};
				for (const b of boxes) {
					const r = Math.min(b.hw, b.hh);
					const qx = Math.abs(x - b.cx) - b.hw + r;
					const qy = Math.abs(y - b.cy) - b.hh + r;
					merge(Math.hypot(Math.max(qx, 0), Math.max(qy, 0)) + Math.min(Math.max(qx, qy), 0) - r);
				}
				for (const blob of blobs) {
					const px = x - blob.x;
					const py = y - blob.y;
					const bx = -blob.tx;
					const by = -blob.ty;
					const span = bx * bx + by * by;
					const h = span > 0.0001 ? clamp01((px * bx + py * by) / span) : 0;
					const value = Math.hypot(px - bx * h, py - by * h) - blob.r;
					if (value > d + smooth) continue;
					merge(value);
				}
				return d;
			};
			const step = 2;
			const parts: string[] = [];
			for (let y = 0; y < view.height; y += 1) {
				const cy = y + 0.5;
				let previous = field(0, cy);
				let start: number | null = previous < 0 ? 0 : null;
				for (let x = step; x <= view.width + step; x += step) {
					const value = field(Math.min(x, view.width), cy);
					if (previous < 0 !== value < 0) {
						const cross = x - step + (step * previous) / (previous - value);
						if (value < 0) start = cross;
						else if (start !== null) {
							parts.push(`M${start.toFixed(1)},${y}H${cross.toFixed(1)}V${y + 1}H${start.toFixed(1)}Z`);
							start = null;
						}
					}
					previous = value;
				}
				if (start !== null) parts.push(`M${start.toFixed(1)},${y}H${view.width}V${y + 1}H${start.toFixed(1)}Z`);
			}
			return parts.join('');
		};

		const pill = (index: number) => {
			if (!pills.has(index)) pills.set(index, { mass: 0, scale: 0, velocity: 0, outgoing: 0 });
			return pills.get(index)!;
		};

		const shape = (index: number, amount: number) => {
			const rect = rects[index];
			if (!rect || amount <= 0.002) return null;
			const h = rect.h * Math.min(1.08, 0.42 + 0.58 * Math.sqrt(Math.max(0, amount)));
			const w = Math.max(h, rect.w * Math.max(0, amount) ** 0.75);
			return { x: rect.x + rect.w / 2 - w / 2, y: rect.y + rect.h / 2 - h / 2, w, h };
		};

		// Give a droplet a curved flight path towards the target item.
		const plan = (drop: Drop, index: number, now: number, fresh: boolean) => {
			const rect = rects[index];
			if (!rect) return;
			const ex = rect.x + rect.w / 2 + (Math.random() - 0.5) * rect.w * 0.45;
			const ey = rect.y + rect.h / 2 + (Math.random() - 0.5) * rect.h * 0.2;
			const base = Math.max(0.15, ANIMATION_TIME / 1000);
			const variance = (Math.random() - 0.5) * (TIME_VARIANCE / 1000);
			const duration = Math.max(0.15, base * (0.62 + Math.random() * 0.32) + variance * 0.6);
			const out = Math.random() * Math.PI * 2;
			const into = Math.random() * Math.PI * 2;
			const burst = SPREAD * (0.7 + Math.random() * 0.6);
			const swing = SPREAD * (0.55 + Math.random() * 0.55);
			const carry = Math.min(duration / 3, 0.12);
			drop.index = index;
			drop.start = now;
			drop.duration = duration;
			drop.path = [
				drop.x,
				drop.y,
				fresh ? drop.x + Math.cos(out) * burst * 1.6 : drop.x + drop.vx * carry,
				fresh ? drop.y + Math.sin(out) * burst * 1.6 : drop.y + drop.vy * carry,
				ex + Math.cos(into) * swing * 1.5,
				ey + Math.sin(into) * swing * 1.5,
				ex,
				ey,
			];
		};

		// Split the pill at `from` into droplets bound for `to`.
		const emit = (from: number, to: number, now: number) => {
			const source = pills.get(from);
			const rect = rects[from];
			if (!source || !rect || !rects[to]) return;
			const available = source.mass - source.outgoing;
			if (available <= 0.002) return;
			const room = MAX_DROPS - drops.length;
			const count = Math.min(room, Math.max(1, Math.round(Math.max(1, PARTICLE_COUNT) * available)));
			if (count <= 0) return;
			const spreadWindow = Math.max(0.15, ANIMATION_TIME / 1000) * 0.16;
			for (let i = 0; i < count; i++) {
				const mass = available / count;
				source.outgoing += mass;
				drops.push({
					x: rect.x + rect.w / 2 + (Math.random() - 0.5) * rect.w * 0.6,
					y: rect.y + rect.h / 2 + (Math.random() - 0.5) * rect.h * 0.3,
					vx: 0, vy: 0, mass, size: 0.8 + Math.random() * 0.4, given: 0,
					source: from, index: to, leave: now + Math.random() * spreadWindow * 1000,
					emerged: 0, absorbed: 0, state: 'waiting',
				});
			}
		};

		const render = () => {
			const height = rects[target]?.h ?? rects[0]?.h ?? 36;
			const smooth = height * (0.18 + 0.5 * clamp01(GOOEYNESS));
			const boxes: Box[] = [];
			const blobs: Blob[] = [];
			for (const [index, state] of pills) {
				const b = shape(index, state.scale);
				if (b) boxes.push({ cx: b.x + b.w / 2, cy: b.y + b.h / 2, hw: b.w / 2, hh: b.h / 2 });
			}
			for (const drop of drops) {
				if (drop.state === 'waiting') continue;
				const radius = 0.26 * height * drop.size * Math.min(drop.emerged, 1 - drop.absorbed);
				if (radius <= 0.05) continue;
				const speed = Math.hypot(drop.vx, drop.vy);
				const length = Math.min(radius * 1.1, speed * 0.018);
				blobs.push({
					x: drop.x, y: drop.y, r: radius,
					tx: speed > 0.01 ? (drop.vx / speed) * length : 0,
					ty: speed > 0.01 ? (drop.vy / speed) * length : 0,
				});
			}

			if (boxes.length === 1 && !blobs.length) {
				const b = boxes[0];
				overlay.style.clipPath = `path('${pillPath(b.cx - b.hw, b.cy - b.hh, b.hw * 2, b.hh * 2)}')`;
			} else {
				overlay.style.clipPath = `path('${trace(boxes, blobs, smooth) || 'M0,0Z'}')`;
			}
			overlay.style.visibility = 'visible';

			if (!pipeline || !gl) {
				const b = shape(target, 1);
				if (b) {
					fallback.style.transform = `translate(${b.x.toFixed(2)}px, ${b.y.toFixed(2)}px)`;
					fallback.style.width = `${b.w}px`;
					fallback.style.height = `${b.h}px`;
				}
				fallback.style.opacity = b ? '1' : '0';
				return;
			}

			let slot = 0;
			for (const b of boxes) {
				if (slot >= MAX_PILLS) break;
				pillData.set([b.cx + MARGIN, b.cy + MARGIN, b.hw, b.hh], slot * 4);
				slot += 1;
			}
			pillData.fill(0, slot * 4);
			let count = 0;
			for (const blob of blobs) {
				if (count >= MAX_DROPS) break;
				dropData.set([blob.x + MARGIN, blob.y + MARGIN, blob.r, 0], count * 4);
				tailData.set([blob.tx, blob.ty], count * 2);
				tintData.set(PILL_RGB, count * 3);
				count += 1;
			}

			const { program, u, buffer, position } = pipeline;
			gl.viewport(0, 0, canvas.width, canvas.height);
			gl.clearColor(0, 0, 0, 0);
			gl.clear(gl.COLOR_BUFFER_BIT);
			gl.useProgram(program);
			gl.bindBuffer(gl.ARRAY_BUFFER, buffer);
			gl.enableVertexAttribArray(position);
			gl.vertexAttribPointer(position, 2, gl.FLOAT, false, 0, 0);
			gl.uniform2f(u.uSize, view.width + MARGIN * 2, view.height + MARGIN * 2);
			gl.uniform1f(u.uRatio, canvas.width / Math.max(1, view.width + MARGIN * 2));
			gl.uniform4fv(u.uPills, pillData);
			gl.uniform4f(u.uHover, hover.x + MARGIN, hover.y + MARGIN, hover.w / 2, hover.h / 2);
			gl.uniform4fv(u.uDrops, dropData);
			gl.uniform2fv(u.uTails, tailData);
			gl.uniform3fv(u.uTints, tintData);
			gl.uniform1i(u.uCount, count);
			gl.uniform1f(u.uSmooth, smooth);
			gl.uniform3f(u.uPill, PILL_RGB[0], PILL_RGB[1], PILL_RGB[2]);
			gl.uniform4f(u.uHoverColor, HOVER_RGBA[0], HOVER_RGBA[1], HOVER_RGBA[2], HOVER_RGBA[3] * hover.alpha);
			gl.uniform1f(u.uShadow, SHADOW);
			gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
		};

		const frame = (now: number) => {
			raf = 0;
			const dt = Math.min(0.05, (now - last) / 1000 || 0);
			last = now;
			const emergeTime = 0.09;
			const absorbTime = 0.12;

			for (let i = drops.length - 1; i >= 0; i--) {
				const drop = drops[i];
				if (drop.state === 'waiting') {
					if (now < drop.leave) continue;
					drop.state = 'flying';
					plan(drop, drop.index, now, true);
				}
				if (drop.state === 'flying') {
					drop.emerged = Math.min(1, drop.emerged + dt / emergeTime);
					const source = pills.get(drop.source);
					if (source && drop.given < drop.mass) {
						const step = Math.min(drop.mass * (dt / emergeTime), drop.mass - drop.given);
						source.mass = Math.max(0, source.mass - step);
						source.outgoing = Math.max(0, source.outgoing - step);
						drop.given += step;
					}
					const t = clamp01((now - drop.start!) / 1000 / drop.duration!);
					const eased = travelEase(t);
					const [x0, y0, x1, y1, x2, y2, x3, y3] = drop.path!;
					const x = bezier(x0, x1, x2, x3, eased);
					const y = bezier(y0, y1, y2, y3, eased);
					if (dt > 0) {
						drop.vx = (x - drop.x) / dt;
						drop.vy = (y - drop.y) / dt;
					}
					drop.x = x;
					drop.y = y;
					if (t >= 1) drop.state = 'absorbing';
				}
				if (drop.state === 'absorbing') {
					const step = Math.min(1 - drop.absorbed, dt / absorbTime);
					drop.absorbed += step;
					drop.vx *= 0.8;
					drop.vy *= 0.8;
					const host = pill(drop.index);
					host.mass = Math.min(1, host.mass + drop.mass * step);
					if (drop.absorbed >= 1) drops.splice(i, 1);
				}
			}

			// Springy size for each pill (the wobble).
			const zeta = reduced ? 1 : 1 - 0.72 * clamp01(WOBBLE);
			const omega = 26;
			const steps = Math.max(1, Math.ceil(dt / (1 / 240)));
			const h = dt / steps;
			for (const [index, state] of pills) {
				for (let n = 0; n < steps; n++) {
					state.velocity += (omega * omega * (state.mass - state.scale) - 2 * zeta * omega * state.velocity) * h;
					state.scale += state.velocity * h;
				}
				if (index !== target && state.mass <= 0.002 && state.outgoing <= 0.002 && Math.abs(state.scale) < 0.004) {
					pills.delete(index);
				}
			}

			if (hover.index >= 0 && rects[hover.index]) {
				const rect = rects[hover.index];
				const k = 1 - Math.exp(-dt / 0.06);
				hover.x += (rect.x + rect.w / 2 - hover.x) * k;
				hover.y += (rect.y + rect.h / 2 - hover.y) * k;
				hover.w += (rect.w - hover.w) * k;
				hover.h += (rect.h - hover.h) * k;
			}
			const hoverGoal = hover.index >= 0 && hover.index !== target ? 1 : 0;
			hover.alpha += (hoverGoal - hover.alpha) * (1 - Math.exp(-dt / 0.08));

			render();

			const host = pills.get(target);
			const resting = drops.length === 0 && pills.size === 1 && host && Math.abs(host.mass - host.scale) < 0.0008 && Math.abs(host.velocity) < 0.004;
			const hoverRect = rects[hover.index];
			const hovering =
				Math.abs(hoverGoal - hover.alpha) > 0.003 ||
				(hoverRect && Math.abs(hoverRect.x + hoverRect.w / 2 - hover.x) + Math.abs(hoverRect.w - hover.w) > 0.1);
			if (!resting || hovering) raf = requestAnimationFrame(frame);
			else if (host) {
				host.mass = 1;
				host.scale = 1;
				host.velocity = 0;
				hover.alpha = hoverGoal;
				render();
			}
		};

		const wake = () => {
			if (raf) return;
			last = performance.now();
			raf = requestAnimationFrame(frame);
		};

		const settle = (index: number) => {
			pills.clear();
			drops.length = 0;
			target = index;
			const state = pill(index);
			state.mass = 1;
			state.scale = 1;
			state.velocity = 0;
			render();
		};

		const go = (index: number) => {
			if (index === target) return;
			if (!rects[index] || reduced || target < 0) {
				settle(index);
				return;
			}
			const now = performance.now();
			target = index;
			pill(index);
			for (const drop of drops) {
				drop.index = index;
				if (drop.state === 'flying') plan(drop, index, now, false);
				if (drop.state === 'absorbing') {
					drop.state = 'flying';
					drop.mass *= 1 - drop.absorbed;
					drop.absorbed = 0;
					plan(drop, index, now, false);
				}
			}
			for (const from of [...pills.keys()]) if (from !== index) emit(from, index, now);
			wake();
		};

		// ---- Events ----
		list.addEventListener('pointerover', (event) => {
			const item = (event.target as HTMLElement).closest<HTMLElement>('[data-gooey-index]');
			if (!item || !list.contains(item)) return;
			const index = Number(item.dataset.gooeyIndex);
			const rect = rects[index];
			if (!rect) return;
			if (hover.alpha < 0.01) {
				hover.x = rect.x + rect.w / 2;
				hover.y = rect.y + rect.h / 2;
				hover.w = rect.w;
				hover.h = rect.h;
			}
			hover.index = index;
			wake();
		});
		list.addEventListener('pointerleave', () => {
			hover.index = -1;
			wake();
		});

		// Clicking another page: play the flow first, then follow the link.
		// New-tab clicks (Ctrl/Cmd/Shift/middle button) behave normally.
		list.addEventListener('click', (event) => {
			const link = (event.target as HTMLElement).closest<HTMLAnchorElement>('a');
			if (!link) return;
			if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
			const index = Number(link.closest<HTMLElement>('[data-gooey-index]')!.dataset.gooeyIndex);
			if (index === target) return;
			event.preventDefault();
			list.querySelectorAll('[data-gooey-index]').forEach((li, i) => li.toggleAttribute('data-active', i === index));
			go(index);
			setTimeout(() => (window.location.href = link.href), reduced ? 0 : NAVIGATE_DELAY);
		});

		new ResizeObserver(() => {
			measure();
			if (!drops.length) settle(target);
			else render();
		}).observe(stage);

		measure();
		settle(Number(nav.dataset.active) || 0);
		document.fonts?.ready.then(() => {
			measure();
			if (!drops.length) settle(target);
		});
		// Coming back via the back button restores the page from cache: snap to its item.
		window.addEventListener('pageshow', (e) => {
			if (!e.persisted) return;
			const index = Number(nav.dataset.active) || 0;
			list.querySelectorAll('[data-gooey-index]').forEach((li, i) => li.toggleAttribute('data-active', i === index));
			settle(index);
		});
	}

	document.querySelectorAll<HTMLElement>('.gooey-nav').forEach(setup);
</script>
