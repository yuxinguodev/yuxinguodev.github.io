---
import type { ExperienceEntry } from '../data/experience';

// Centre-axis timeline: entries alternate left and right of a vertical line.
// It lives in a fixed-height box scrolled with the mouse wheel (scrollbar
// hidden). The entry nearest the focus line becomes "active" and its dot
// turns into an animated neon six-pointed star.
interface Props {
	items: ExperienceEntry[];
}

const { items } = Astro.props;

// Spiky six-pointed star centred on (0, 0).
function starPath(points: number, outer: number, inner: number) {
	const pts: string[] = [];
	for (let i = 0; i < points * 2; i++) {
		const r = i % 2 === 0 ? outer : inner;
		const a = (Math.PI * i) / points - Math.PI / 2;
		pts.push(`${(r * Math.cos(a)).toFixed(2)},${(r * Math.sin(a)).toFixed(2)}`);
	}
	return `M${pts.join('L')}Z`;
}
const star = starPath(6, 46, 13);
const sparkle = starPath(4, 9, 2.2);
---

<div class="timeline-scroll at-top" tabindex="0" aria-label="Experience timeline, scrollable">
	<ol class="timeline">
		{items.map((item, i) => (
			<li class:list={['entry', i % 2 === 0 ? 'left' : 'right', { current: item.current, active: i === 0, education: item.kind === 'education', game: item.kind === 'game' }]}>
				<div class="content">
					<p class="period">{item.period}</p>
					<h3><span class="mark">{item.title}</span></h3>
					<p class="org">{item.org}</p>
					{item.location && <p class="location">{item.location}</p>}
					{item.description && <p class="desc">{item.description}</p>}
					{item.tags && (
						<ul class="tags">
							{item.tags.map((tag) => <li>{tag}</li>)}
						</ul>
					)}
				</div>
				<span class="node" aria-hidden="true">
					<span class="dot"></span>
					<svg class="star" viewBox="-60 -60 120 120">
						<defs>
							<linearGradient id={`hex-fill-${i}`} x1="0" y1="-1" x2="0" y2="1" gradientUnits="objectBoundingBox">
								<stop offset="0" stop-color="#ffb347" />
								<stop offset="0.4" stop-color="#ff2d95" />
								<stop offset="1" stop-color="#6b2cff" />
							</linearGradient>
						</defs>
						<g class="spin">
							<path class="ghost" d={star} />
							<path class="body" d={star} fill={`url(#hex-fill-${i})`} />
							<path class="rim" d={star} />
						</g>
						<path class="spark s1" d={sparkle} />
						<path class="spark s2" d={sparkle} />
					</svg>
				</span>
			</li>
		))}
	</ol>
</div>

<style>
	/* Fixed-height box, scrolled with the wheel; edges fade where more content is hidden. */
	.timeline-scroll {
		--fade-top: 40px;
		--fade-bottom: 56px;
		max-height: 360px;
		overflow-y: auto;
		overscroll-behavior: auto; /* at either end the page carries on scrolling */
		padding: 1rem 0;
		scrollbar-width: none;
		/* Touch / trackpad: settle on one entry at a time (wheel is handled in the script). */
		scroll-snap-type: y mandatory;
		-webkit-mask-image: linear-gradient(transparent, #000 var(--fade-top), #000 calc(100% - var(--fade-bottom)), transparent);
		mask-image: linear-gradient(transparent, #000 var(--fade-top), #000 calc(100% - var(--fade-bottom)), transparent);
	}
	.timeline-scroll::-webkit-scrollbar {
		display: none;
	}
	.timeline-scroll.at-top {
		--fade-top: 0px;
	}
	.timeline-scroll.at-bottom {
		--fade-bottom: 0px;
	}
	.timeline-scroll:focus-visible {
		outline: 1px solid var(--border);
		outline-offset: 6px;
		border-radius: 8px;
	}

	.timeline {
		position: relative;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	/* The central axis. */
	.timeline::before {
		content: '';
		position: absolute;
		top: 0;
		bottom: 0;
		left: 50%;
		width: 1px;
		transform: translateX(-50%);
		background: linear-gradient(transparent, #3a4150 6%, #3a4150 94%, transparent);
	}

	/* Three columns: left content | axis | right content. */
	.entry {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 64px minmax(0, 1fr);
		align-items: start;
		padding-bottom: 2.25rem;
	}
	.entry:last-child {
		padding-bottom: 0;
	}
	/* Stagger: each entry tucks up beside the previous one (they sit on opposite sides). */
	.entry + .entry {
		margin-top: -3.5rem;
	}
	.node {
		grid-column: 2;
		grid-row: 1;
		position: relative;
		justify-self: center;
		width: 64px;
		height: 40px;
		margin-top: 2px;
	}
	.left .content {
		grid-column: 1;
		grid-row: 1;
		text-align: right;
	}
	.right .content {
		grid-column: 3;
		grid-row: 1;
	}
	.left .tags {
		justify-content: flex-end;
	}

	.content {
		scroll-snap-align: center; /* touch / trackpad settle with the text in the middle */
		transition: opacity 0.3s;
		opacity: 0.55;
	}
	.entry.active .content {
		opacity: 1;
	}
	.period {
		margin: 0 0 0.1rem;
		font-size: 14px;
		color: rgb(var(--gray));
	}
	.entry.current .period {
		color: var(--accent);
	}
	h3 {
		margin: 0 0 0.15rem;
		font-size: 19px;
	}
	/* Education: green highlighter stroke behind the title (every line when it wraps).
	   Colours match the green "n" and red "u" of the hero name. */
	.education .mark {
		background: linear-gradient(transparent 58%, rgba(63, 145, 82, 0.55) 58%, rgba(63, 145, 82, 0.55) 92%, transparent 92%);
		-webkit-box-decoration-break: clone;
		box-decoration-break: clone;
		padding: 0 0.15em;
	}
	/* ...and a green ring on its timeline dot. */
	.education .dot {
		border-color: #3f9152;
	}
	/* Game: same treatment in red. */
	.game .mark {
		background: linear-gradient(transparent 58%, rgba(226, 52, 79, 0.5) 58%, rgba(226, 52, 79, 0.5) 92%, transparent 92%);
		-webkit-box-decoration-break: clone;
		box-decoration-break: clone;
		padding: 0 0.15em;
	}
	.game .dot {
		border-color: #e2344f;
	}
	.org {
		margin: 0 0 0.5rem;
		font-size: 15px;
		color: rgb(var(--gray-dark));
	}
	/* Location sits on its own line under the organisation. */
	.location {
		margin: -0.4rem 0 0.5rem;
		font-size: 14px;
		color: rgb(var(--gray));
	}
	.desc {
		margin: 0 0 0.75rem;
		font-size: 15px;
		line-height: 1.6;
		color: rgb(var(--gray));
	}
	.tags {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.tags li {
		font-size: 13px;
		padding: 0.1rem 0.6rem;
		color: rgb(var(--gray-dark));
		background: var(--surface-raised);
		border-radius: 999px;
	}

	/* Resting dot. */
	.dot {
		position: absolute;
		left: 50%;
		top: 50%;
		width: 11px;
		height: 11px;
		box-sizing: border-box;
		background: #000;
		border: 2px solid rgb(var(--gray));
		border-radius: 50%;
		transform: translate(-50%, -50%);
		transition: opacity 0.2s, transform 0.3s;
	}
	.entry.active .dot {
		opacity: 0;
		transform: translate(-50%, -50%) scale(0.3);
	}

	/* Active: neon six-pointed star with an offset ghost outline and sparkles. */
	.star {
		position: absolute;
		left: 50%;
		top: 50%;
		width: 64px;
		height: 64px;
		overflow: visible;
		transform: translate(-50%, -50%) scale(0) rotate(-90deg);
		opacity: 0;
		transition:
			transform 0.5s cubic-bezier(0.34, 1.7, 0.5, 1),
			opacity 0.25s;
		filter: drop-shadow(0 0 5px rgba(255, 70, 200, 0.8)) drop-shadow(0 0 14px rgba(110, 220, 255, 0.45));
	}
	.entry.active .star {
		opacity: 1;
		transform: translate(-50%, -50%) scale(1) rotate(0deg);
	}
	.spin {
		transform-box: fill-box;
		transform-origin: center;
		animation:
			spin 16s linear infinite,
			pulse 1.6s ease-in-out infinite alternate;
	}
	.body {
		opacity: 0.95;
	}
	.rim {
		fill: none;
		stroke: #fff;
		stroke-width: 2.5;
		stroke-linejoin: miter;
	}
	.ghost {
		fill: none;
		stroke: #7fe7ff;
		stroke-width: 2.5;
		stroke-linejoin: miter;
		transform-box: fill-box;
		transform-origin: center;
		animation: jitter 0.9s steps(2, jump-none) infinite;
	}
	.spark {
		fill: #bff3ff;
		transform-origin: center;
		transform-box: fill-box;
		animation: twinkle 1.8s ease-in-out infinite;
	}
	.s1 {
		translate: 40px -36px;
	}
	.s2 {
		translate: -42px 34px;
		animation-delay: -0.9s;
	}

	@keyframes spin {
		to {
			rotate: 360deg;
		}
	}
	@keyframes pulse {
		from {
			scale: 0.94;
		}
		to {
			scale: 1.12;
		}
	}
	@keyframes jitter {
		0% {
			transform: translate(4px, -3px) rotate(4deg);
		}
		50% {
			transform: translate(-3px, 3px) rotate(-3deg);
		}
		100% {
			transform: translate(3px, 2px) rotate(2deg);
		}
	}
	@keyframes twinkle {
		0%,
		100% {
			opacity: 0.2;
			scale: 0.5;
		}
		50% {
			opacity: 1;
			scale: 1.1;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.spin,
		.ghost,
		.spark {
			animation: none;
		}
	}

	/* Narrow screens: axis on the left, everything to its right. */
	@media (max-width: 720px) {
		.timeline::before {
			left: 24px;
		}
		.entry {
			grid-template-columns: 48px minmax(0, 1fr);
		}
		.node {
			grid-column: 1;
			width: 48px;
		}
		.left .content,
		.right .content {
			grid-column: 2;
			text-align: left;
		}
		.left .tags {
			justify-content: flex-start;
		}
		/* Single column: no room to overlap. */
		.entry + .entry {
			margin-top: 0;
		}
	}
</style>

<script>
	const box = document.querySelector<HTMLElement>('.timeline-scroll');
	if (box) {
		const list = box.querySelector<HTMLElement>('.timeline')!;
		const entries = [...box.querySelectorAll<HTMLElement>('.entry')];
		const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		let current = 0;

		const content = (el: HTMLElement) => el.querySelector<HTMLElement>('.content')!;
		const middle = (el: HTMLElement) => {
			const r = content(el).getBoundingClientRect();
			return r.top + r.height / 2;
		};
		const boxMiddle = () => {
			const r = box.getBoundingClientRect();
			return r.top + r.height / 2;
		};
		// scrollTop that puts entry i in the vertical middle of the box.
		const centred = (i: number) => box.scrollTop + middle(entries[i]) - boxMiddle();

		// Space above the first and below the last entry so both can reach the middle too.
		const fitSpace = () => {
			const half = box.clientHeight / 2;
			list.style.paddingTop = `${Math.max(0, half - content(entries[0]).offsetHeight / 2 - 16)}px`;
			list.style.paddingBottom = `${Math.max(0, half - content(entries[entries.length - 1]).offsetHeight / 2 - 16)}px`;
		};

		const update = () => {
			box.classList.toggle('at-top', box.scrollTop <= 2);
			box.classList.toggle('at-bottom', box.scrollTop + box.clientHeight >= box.scrollHeight - 2);
			// Active entry: the one whose middle is nearest the middle of the box.
			const mid = boxMiddle();
			let best = Infinity;
			entries.forEach((el, i) => {
				const d = Math.abs(middle(el) - mid);
				if (d < best) {
					best = d;
					current = i;
				}
			});
			entries.forEach((el, i) => el.classList.toggle('active', i === current));
		};

		// Mouse wheel: one notch moves exactly one entry. Past the first or last
		// entry the event is left alone so the page keeps scrolling.
		let target = 0;
		let lockedUntil = 0;
		box.addEventListener(
			'wheel',
			(e) => {
				if (Math.abs(e.deltaY) < 2) return;
				const now = performance.now();
				const from = now < lockedUntil ? target : current;
				const next = from + Math.sign(e.deltaY);
				if (next < 0 || next >= entries.length) return;
				e.preventDefault();
				if (now < lockedUntil) return; // still settling from the last step
				target = next;
				lockedUntil = now + 550;
				box.scrollTo({ top: centred(next), behavior: reduced ? 'auto' : 'smooth' });
			},
			{ passive: false },
		);

		box.addEventListener('scroll', update, { passive: true });
		window.addEventListener('resize', () => { fitSpace(); update(); }, { passive: true });
		fitSpace();
		box.scrollTop = centred(0); // start with the first entry in the middle
		update();
	}
</script>
