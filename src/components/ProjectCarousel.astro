---
// A slowly drifting, endlessly looping strip of pill-shaped project covers.
// Items are squeezed and dimmed the further they are from the centre, as if
// wrapped around a cylinder, so the neighbours read as ovals. Thin vertical
// "PIC 01" labels sit between items. Hover pauses; clicking opens the project.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import GradientCover from './GradientCover.astro';

interface Item {
	href?: string;
	title: string;
	image?: ImageMetadata;
	seed?: string; // gradient colours when there is no image
}

interface Props {
	items: Item[];
}

const { items } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
// The list is rendered twice so the strip can loop without a gap.
const loops = [0, 1];
---

<div class="carousel" data-carousel>
	<div class="track">
		{loops.map((loop) =>
			items.map((item, i) => (
				<>
					<span class="label" aria-hidden="true">
						<span class="label-text">PIC {pad(i + 1)}</span>
						<span class="label-line"></span>
					</span>
					<a
						class="slide"
						href={item.href ?? undefined}
						aria-hidden={loop === 1 ? 'true' : undefined}
						tabindex={loop === 1 || !item.href ? -1 : undefined}
					>
						<span class="frame">
							{item.image ? (
								<Image src={item.image} alt="" width={840} height={472} loading="eager" />
							) : (
								<GradientCover seed={item.seed ?? item.title} />
							)}
						</span>
						<span class="caption">{item.title}</span>
					</a>
				</>
			)),
		)}
	</div>
</div>

<style>
	.carousel {
		position: relative;
		overflow: hidden;
		margin: 0 calc(50% - 50vw) 3.5rem; /* full-bleed across the window */
		padding: 2.5rem 0 1rem;
		/* Fade the far left and right edges into the background. */
		-webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
		mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
	}
	.track {
		display: flex;
		align-items: flex-start;
		width: max-content;
		will-change: transform;
	}
	.slide {
		display: flex;
		flex-direction: column;
		align-items: center;
		width: 440px;
		color: inherit;
		text-decoration: none;
		transform-origin: center 40%;
		will-change: transform, opacity;
	}
	.frame {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		aspect-ratio: 630 / 354;
		overflow: hidden;
		border-radius: 999px;
		background: #121212;
		border: 1px solid #1f1f1f;
	}
	.frame :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 0;
	}
	.caption {
		margin-top: 1.4rem;
		font-size: 17px;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: rgb(var(--gray-dark));
		white-space: nowrap;
	}
	a.slide[href]:hover .caption {
		color: rgb(var(--black));
	}
	/* Vertical divider with a small "PIC 01" tag on top. */
	.label {
		display: flex;
		flex-direction: column;
		align-items: center;
		width: 64px;
		margin-top: -1.6rem;
	}
	.label-text {
		font-size: 11px;
		letter-spacing: 0.1em;
		color: rgb(var(--gray));
		white-space: nowrap;
	}
	.label-line {
		width: 1px;
		height: 250px;
		margin-top: 0.8rem;
		background: rgba(255, 255, 255, 0.22);
	}
	@media (max-width: 720px) {
		.slide {
			width: 260px;
		}
		.label-line {
			height: 150px;
		}
		.caption {
			font-size: 14px;
		}
	}
</style>

<script>
	const SPEED = 38; // px per second

	document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
		const track = root.querySelector<HTMLElement>('.track')!;
		const parts = [...track.children] as HTMLElement[]; // labels and slides, both loops
		const slides = parts.filter((el) => el.classList.contains('slide'));
		const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		let half = 0; // width of one loop
		let offset = 0;
		let paused = false;
		let last = 0;

		const measure = () => {
			half = track.scrollWidth / 2;
			// Start with the first slide in the middle of the window. Wrapped into
			// [0, half) so the copy of the list fills the left side as well.
			const first = slides[0];
			const raw = first.offsetLeft + first.offsetWidth / 2 - root.clientWidth / 2;
			offset = ((raw % half) + half) % half;
		};

		// Squeeze, shrink and dim each slide by its distance from the centre.
		const shape = () => {
			const mid = root.clientWidth / 2;
			for (const el of slides) {
				const centre = el.offsetLeft - offset + el.offsetWidth / 2;
				const d = Math.max(-1, Math.min(1, (centre - mid) / (root.clientWidth * 0.55)));
				const k = d * d;
				el.style.transform = `scale(${(1 - 0.18 * k).toFixed(3)}) scaleX(${(1 - 0.42 * k).toFixed(3)})`;
				el.style.opacity = (1 - 0.45 * k).toFixed(3);
			}
		};

		const frame = (now: number) => {
			const dt = last ? Math.min(0.05, (now - last) / 1000) : 0;
			last = now;
			if (!paused) {
				offset += SPEED * dt;
				if (offset >= half) offset -= half; // seamless wrap
			}
			track.style.transform = `translateX(${(-offset).toFixed(1)}px)`;
			shape();
			requestAnimationFrame(frame);
		};

		root.addEventListener('pointerenter', () => (paused = true));
		root.addEventListener('pointerleave', () => (paused = false));
		root.addEventListener('focusin', () => (paused = true));
		root.addEventListener('focusout', () => (paused = false));

		const start = () => {
			measure();
			track.style.transform = `translateX(${(-offset).toFixed(1)}px)`;
			shape();
		};
		new ResizeObserver(start).observe(root);
		start();
		if (!reduced) requestAnimationFrame(frame);
	});
</script>
