---
// Article covers circling a tilted elliptical orbit, with whatever is in the
// slot (the page title) floating in the middle. Items at the front of the
// orbit are larger and brighter, items at the back smaller and dimmer.
// Hovering an item pauses the orbit and shows its title.
//
// Styled as Japanese retro neon: a pink-to-blue glowing track, a comet with a
// fading tail running along it, twinkling four-point sparkles, floating neon
// hearts and diagonal speed streaks.
//
// Inspired by "Orbit Images" in React Bits (https://reactbits.dev/c/animations/orbit-images,
// created by Dominik Koch); this is a separate, simplified implementation.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
	items: { href: string; title: string; image?: ImageMetadata }[];
}

const { items } = Astro.props;

const COMET_TAIL = 22; // trail dots behind the comet head
// Sparkles and hearts sit at these points around the orbit (angle in turns, radial offset).
const sparkles = [
	{ at: 0.07, off: 1.12, size: 16, delay: 0 },
	{ at: 0.31, off: 0.86, size: 11, delay: 0.7 },
	{ at: 0.46, off: 1.15, size: 19, delay: 1.3 },
	{ at: 0.63, off: 0.9, size: 12, delay: 0.4 },
	{ at: 0.82, off: 1.1, size: 15, delay: 1.0 },
	{ at: 0.95, off: 0.84, size: 10, delay: 1.6 },
];
const hearts = [
	{ at: 0.18, off: 1.22, size: 22, delay: 0 },
	{ at: 0.55, off: 1.26, size: 18, delay: 1.2 },
	{ at: 0.74, off: 0.74, size: 15, delay: 2.1 },
];
const streaks = Array.from({ length: 9 }, (_, i) => ({
	top: (i * 37) % 100,
	left: (i * 53 + 20) % 110,
	len: 90 + ((i * 41) % 120),
	delay: -((i * 1.7) % 6),
	dur: 4.5 + ((i * 0.9) % 3),
}));
const SPARKLE = 'M0,-10 C1.2,-2 2,-1.2 10,0 C2,1.2 1.2,2 0,10 C-1.2,2 -2,1.2 -10,0 C-2,-1.2 -1.2,-2 0,-10Z';
const HEART = 'M0,6 C-9,-1 -9,-8 -4.5,-8 C-2,-8 0,-6 0,-4.5 C0,-6 2,-8 4.5,-8 C9,-8 9,-1 0,6Z';
---

<div class="orbit" data-orbit>
	<!-- Diagonal neon speed streaks behind everything. -->
	<div class="streaks" aria-hidden="true">
		{streaks.map((s) => (
			<span style={`top:${s.top}%;left:${s.left}%;width:${s.len}px;animation-delay:${s.delay}s;animation-duration:${s.dur}s`}></span>
		))}
	</div>

	<svg class="track" aria-hidden="true" preserveAspectRatio="none">
		<defs>
			<linearGradient id="orbit-neon" x1="0" y1="0" x2="1" y2="0">
				<stop offset="0" stop-color="#ff4fd8" />
				<stop offset="0.5" stop-color="#a855ff" />
				<stop offset="1" stop-color="#4d7cff" />
			</linearGradient>
			<filter id="orbit-glow" x="-20%" y="-20%" width="140%" height="140%">
				<feGaussianBlur stdDeviation="4" />
			</filter>
			<filter id="comet-glow" x="-200%" y="-200%" width="500%" height="500%">
				<feGaussianBlur stdDeviation="3.5" result="b" />
				<feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
			</filter>
		</defs>
		<g class="track-group">
			<!-- Filled bands rather than strokes, so the width can change around the orbit. -->
			<path class="track-glow" filter="url(#orbit-glow)" fill-rule="evenodd"></path>
			<path class="track-line" fill-rule="evenodd"></path>
		</g>
		<g class="comet" filter="url(#comet-glow)">
			{Array.from({ length: COMET_TAIL }, () => <circle class="tail" r="2"></circle>)}
			<circle class="head" r="5"></circle>
		</g>
		{sparkles.map((s) => (
			<g class="deco" data-at={s.at} data-off={s.off} data-size={s.size}><path class="sparkle" d={SPARKLE} style={`animation-delay:${s.delay}s`}></path></g>
		))}
		{hearts.map((h) => (
			<g class="deco" data-at={h.at} data-off={h.off} data-size={h.size}><path class="heart" d={HEART} style={`animation-delay:${h.delay}s`}></path></g>
		))}
	</svg>

	<div class="center"><slot /></div>
	{items.map((item) => (
		<a class="orbit-item" href={item.href} aria-label={item.title}>
			{item.image ? <Image src={item.image} alt="" width={240} height={240} loading="eager" /> : <span class="blank"></span>}
			<span class="tip" aria-hidden="true">{item.title}</span>
		</a>
	))}
</div>

<style>
	.orbit {
		position: relative;
		height: 480px;
		margin-bottom: 3rem;
		user-select: none;
	}

	/* Speed streaks: thin pink/violet lines sliding down-left. */
	.streaks {
		position: absolute;
		inset: -10% -5%;
		overflow: hidden;
		pointer-events: none;
		-webkit-mask-image: radial-gradient(closest-side, #000 55%, transparent);
		mask-image: radial-gradient(closest-side, #000 55%, transparent);
	}
	.streaks span {
		position: absolute;
		height: 1.5px;
		border-radius: 2px;
		background: linear-gradient(90deg, transparent, rgba(255, 110, 220, 0.75), rgba(170, 120, 255, 0.4), transparent);
		transform: rotate(-32deg);
		opacity: 0;
		animation: streak 5s linear infinite;
	}
	.streaks span:nth-child(3n) {
		background: linear-gradient(90deg, transparent, rgba(120, 170, 255, 0.7), transparent);
	}
	@keyframes streak {
		0% {
			opacity: 0;
			translate: 120px -75px;
		}
		15%,
		70% {
			opacity: 1;
		}
		100% {
			opacity: 0;
			translate: -260px 160px;
		}
	}

	.track {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		overflow: visible;
		pointer-events: none;
	}
	.track-line {
		fill: url(#orbit-neon);
	}
	.track-glow {
		fill: url(#orbit-neon);
		opacity: 0.55;
	}
	.head {
		fill: #ffe3fb;
	}
	.tail {
		fill: #ff5ad9;
	}

	/* Four-point sparkles twinkle; neon hearts float gently. */
	.sparkle {
		fill: #f4d9ff;
		filter: drop-shadow(0 0 4px #ff6be0) drop-shadow(0 0 10px rgba(160, 110, 255, 0.8));
		animation: twinkle 2.2s ease-in-out infinite;
		transform-origin: 0 0;
	}
	.heart {
		fill: none;
		stroke: #ff5ad9;
		stroke-width: 1.4;
		filter: drop-shadow(0 0 3px #ff5ad9) drop-shadow(0 0 9px rgba(255, 90, 217, 0.7));
		/* Float gently and flicker like a neon tube; each heart has its own delay. */
		animation:
			bob 4s ease-in-out infinite,
			flicker 3.2s linear infinite;
		transform-origin: 0 0;
	}
	@keyframes twinkle {
		0%,
		100% {
			opacity: 0.25;
			scale: 0.55;
		}
		50% {
			opacity: 1;
			scale: 1.1;
		}
	}
	@keyframes bob {
		0%,
		100% {
			translate: 0 0;
		}
		50% {
			translate: 0 -6px;
		}
	}
	/* Mostly lit, with quick stutters and a short dim spell. */
	@keyframes flicker {
		0%,
		18%,
		22%,
		25%,
		53%,
		57%,
		100% {
			opacity: 1;
		}
		20%,
		24% {
			opacity: 0.25;
		}
		55% {
			opacity: 0.45;
		}
		70% {
			opacity: 0.85;
		}
		78% {
			opacity: 0.3;
		}
		82% {
			opacity: 1;
		}
	}

	.center {
		position: absolute;
		left: 50%;
		top: 50%;
		z-index: 5;
		transform: translate(-50%, -50%);
		text-align: center;
		pointer-events: none;
	}

	/* Covers with a pink/violet neon rim. */
	.orbit-item {
		position: absolute;
		left: 0;
		top: 0;
		width: 128px;
		height: 128px;
		margin: -64px 0 0 -64px; /* position by centre */
		border-radius: 22px;
		will-change: transform, opacity;
	}
	.orbit-item :global(img),
	.blank {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 22px;
		border: 1px solid rgba(255, 120, 225, 0.55);
		box-shadow:
			0 0 12px rgba(255, 80, 210, 0.45),
			0 0 32px rgba(140, 90, 255, 0.25),
			0 14px 30px rgba(0, 0, 0, 0.55);
		background: var(--surface-raised);
		transition: box-shadow 0.2s, border-color 0.2s;
	}
	.orbit-item:hover :global(img),
	.orbit-item:focus-visible :global(img) {
		border-color: rgba(255, 190, 240, 0.95);
		box-shadow:
			0 0 18px rgba(255, 80, 210, 0.8),
			0 0 44px rgba(140, 90, 255, 0.5),
			0 18px 40px rgba(0, 0, 0, 0.6);
	}
	.tip {
		position: absolute;
		left: 50%;
		top: calc(100% + 10px);
		transform: translateX(-50%);
		padding: 5px 10px;
		font-size: 13px;
		white-space: nowrap;
		color: #ffe3fb;
		background: rgba(30, 12, 40, 0.92);
		border: 1px solid rgba(255, 90, 217, 0.5);
		border-radius: 8px;
		box-shadow: 0 0 12px rgba(255, 90, 217, 0.35);
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.15s;
	}
	.orbit-item:hover .tip,
	.orbit-item:focus-visible .tip {
		opacity: 1;
	}

	@media (prefers-reduced-motion: reduce) {
		.streaks span,
		.sparkle,
		.heart {
			animation: none;
		}
		.streaks {
			display: none;
		}
	}
	@media (max-width: 720px) {
		.orbit {
			height: 360px;
		}
		.orbit-item {
			width: 84px;
			height: 84px;
			margin: -42px 0 0 -42px;
		}
	}
</style>

<script>
	const TILT = (-10 * Math.PI) / 180; // orbit tilt
	const SPEED = 0.12; // radians per second for the covers
	const COMET_SPEED = 0.55; // the comet laps faster
	const TAIL_SPACING = 0.022; // radians between trail dots

	document.querySelectorAll<HTMLElement>('[data-orbit]').forEach((orbit) => {
		const items = [...orbit.querySelectorAll<HTMLElement>('.orbit-item')];
		const svg = orbit.querySelector<SVGSVGElement>('.track')!;
		const trackLine = orbit.querySelector<SVGPathElement>('.track-line')!;
		const trackGlow = orbit.querySelector<SVGPathElement>('.track-glow')!;
		const head = orbit.querySelector<SVGCircleElement>('.head')!;
		const tail = [...orbit.querySelectorAll<SVGCircleElement>('.tail')];
		const decorations = [...orbit.querySelectorAll<SVGGElement>('.deco')];
		const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		let w = 0, h = 0, rx = 0, ry = 0;
		let angle = 0;
		let comet = 0;
		let paused = false;
		let last = 0;
		const cos = Math.cos(TILT), sin = Math.sin(TILT);

		// Point on the tilted ellipse at angle t, scaled radially by k.
		const point = (t: number, k = 1) => {
			const ex = rx * k * Math.cos(t);
			const ey = ry * k * Math.sin(t);
			return [w / 2 + ex * cos - ey * sin, h / 2 + ex * sin + ey * cos];
		};

		// A ring around the orbit whose width grows from minW at the back (top)
		// to maxW at the front (bottom), for a sense of depth.
		const band = (minW: number, maxW: number) => {
			const N = 180;
			const outer: string[] = [];
			const inner: string[] = [];
			for (let i = 0; i <= N; i++) {
				const t = (i / N) * Math.PI * 2;
				const [x, y] = point(t);
				const [x1, y1] = point(t + 0.001);
				const len = Math.hypot(x1 - x, y1 - y) || 1;
				const nx = -(y1 - y) / len;
				const ny = (x1 - x) / len;
				const depth = (Math.sin(t) + 1) / 2;
				const half = (minW + (maxW - minW) * depth ** 1.5) / 2;
				outer.push(`${(x + nx * half).toFixed(1)},${(y + ny * half).toFixed(1)}`);
				inner.push(`${(x - nx * half).toFixed(1)},${(y - ny * half).toFixed(1)}`);
			}
			return `M${outer.join('L')}ZM${inner.reverse().join('L')}Z`;
		};

		const measure = () => {
			w = orbit.clientWidth;
			h = orbit.clientHeight;
			rx = w * 0.42;
			ry = h * 0.3;
			svg.setAttribute('viewBox', `0 0 ${w} ${h}`);
			trackLine.setAttribute('d', band(0.8, 4));
			trackGlow.setAttribute('d', band(2, 16));
			// Sparkles and hearts: fixed spots around the orbit.
			for (const d of decorations) {
				const [x, y] = point(Number(d.dataset.at) * Math.PI * 2, Number(d.dataset.off));
				const s = Number(d.dataset.size) / 20;
				d.setAttribute('transform', `translate(${x.toFixed(1)} ${y.toFixed(1)}) scale(${s})`);
			}
		};

		const place = () => {
			items.forEach((el, i) => {
				const t = angle + (i / items.length) * Math.PI * 2;
				const [x, y] = point(t);
				const depth = (Math.sin(t) + 1) / 2; // 0 = back, 1 = front
				const scale = 0.55 + 0.5 * depth;
				el.style.transform = `translate(${x.toFixed(1)}px, ${y.toFixed(1)}px) scale(${scale.toFixed(3)})`;
				el.style.opacity = (0.4 + 0.6 * depth).toFixed(3);
				// Back half goes behind the centre title, front half in front of it.
				el.style.zIndex = String(depth > 0.5 ? 10 + Math.round(depth * 10) : 1 + Math.round(depth * 4));
			});
			// Comet head plus a tail that thins and fades behind it.
			const [hx, hy] = point(comet);
			head.setAttribute('cx', hx.toFixed(1));
			head.setAttribute('cy', hy.toFixed(1));
			tail.forEach((dot, i) => {
				const f = 1 - (i + 1) / (tail.length + 1);
				const [x, y] = point(comet - (i + 1) * TAIL_SPACING);
				dot.setAttribute('cx', x.toFixed(1));
				dot.setAttribute('cy', y.toFixed(1));
				dot.setAttribute('r', (0.6 + 3.6 * f).toFixed(2));
				dot.setAttribute('opacity', (f * 0.9).toFixed(2));
			});
		};

		const frame = (now: number) => {
			const dt = last ? Math.min(0.05, (now - last) / 1000) : 0;
			last = now;
			if (!paused) angle += SPEED * dt;
			comet += COMET_SPEED * dt; // keeps flying even while covers pause
			place();
			requestAnimationFrame(frame);
		};

		orbit.addEventListener('pointerover', (e) => {
			if ((e.target as HTMLElement).closest('.orbit-item')) paused = true;
		});
		orbit.addEventListener('pointerout', (e) => {
			if (!(e.relatedTarget as HTMLElement | null)?.closest?.('.orbit-item')) paused = false;
		});
		orbit.addEventListener('focusin', () => (paused = true));
		orbit.addEventListener('focusout', () => (paused = false));

		new ResizeObserver(() => {
			measure();
			place();
		}).observe(orbit);
		measure();
		comet = Math.PI * 0.15;
		place();
		if (!reduced) requestAnimationFrame(frame);
	});
</script>
