---
import type { CollectionEntry } from 'astro:content';

// 这个组件接收一个参数：project
interface Props {
	project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, summary, cover, tags } = project.data;
---

<a class="card" href={`/projects/${project.id}/`}>
	{cover && <img src={cover} alt={title} loading="lazy" />}
	<h3>{title}</h3>
	<p>{summary}</p>
	<ul class="tags">
		{tags.map((tag) => <li>{tag}</li>)}
	</ul>
</a>

<style>
	.card {
		display: block; padding: 1.5rem; color: inherit; text-decoration: none;
		border: 1px solid #ddd; border-radius: 8px;
	}
	.card:hover { border-color: var(--accent); }
	.card img { width: 100%; border-radius: 4px; }
	.card h3 { margin: 0.5rem 0; }
	.tags { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
	.tags li { font-size: 0.85rem; padding: 0.1rem 0.6rem; background: #eee; border-radius: 999px; }
</style>