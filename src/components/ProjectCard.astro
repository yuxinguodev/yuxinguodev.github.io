---
import type { ImageMetadata } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import MetalObject from './MetalObject.astro';

// project：要展示的项目；image：封面图（没有时用银色物件代替）
interface Props {
	project: CollectionEntry<'projects'>;
	image?: ImageMetadata;
	shape?: 'star' | 'ring' | 'pill' | 'wave';
}

const { project, image, shape = 'star' } = Astro.props;
const { title, github, status } = project.data;
const href = `/projects/${project.id}/`;
---

<article class="card">
	<a class="cover" href={href} aria-label={title}>
		{image ? (
			<Image src={image} alt="" width={860} class="cover-img" />
		) : (
			<MetalObject shape={shape} />
		)}
	</a>
	<div class="meta">
		<div>
			<h3><a href={href}>{title}</a></h3>
			<p class="status">{status === 'completed' ? 'Completed' : 'In progress'}</p>
		</div>
		<div class="buttons">
			{github && (
				<a class="icon-btn" href={github} target="_blank" rel="noopener" aria-label="Source code on GitHub">
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 8l-4 4l4 4" /><path d="M17 8l4 4l-4 4" /><path d="M14 4l-4 16" /></svg>
				</a>
			)}
			<a class="icon-btn" href={href} aria-label="Open project page">
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17 7l-10 10" /><path d="M8 7l9 0l0 9" /></svg>
			</a>
		</div>
	</div>
</article>

<style>
	.cover {
		display: flex;
		align-items: center;
		justify-content: center;
		/* Same frame for every cover; images are cropped to fit (object-fit below). */
		aspect-ratio: 16 / 10;
		box-sizing: border-box;
		overflow: hidden;
		background: #121212;
		border: 1px solid #1f1f1f;
		border-radius: 16px;
		transition: border-color 0.2s;
	}
	.cover:hover {
		border-color: #333;
	}
	.cover:hover :global(.metal) {
		transform: scale(1.06);
	}
	/* Image fills the cover and zooms in slightly on hover. */
	.cover :global(.cover-img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		border-radius: 0;
		transition: transform 0.4s ease;
	}
	.cover:hover :global(.cover-img) {
		transform: scale(1.04);
	}
	.meta {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
		padding: 1rem 0.5rem 0;
	}
	h3 {
		margin: 0;
		font-size: 19px;
	}
	h3 a {
		color: rgb(var(--black));
		text-decoration: none;
	}
	.status {
		margin: 0;
		font-size: 14px;
		color: rgb(var(--gray));
	}
	.buttons {
		display: flex;
		gap: 10px;
	}
	.icon-btn {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 48px;
		height: 48px;
		color: rgb(var(--gray-dark));
		background: #0f0f0f;
		border: 1px solid var(--border);
		border-radius: 12px;
		transition: border-color 0.15s, color 0.15s;
	}
	.icon-btn:hover {
		color: rgb(var(--black));
		border-color: rgb(var(--gray));
	}
	.icon-btn svg {
		width: 22px;
		height: 22px;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
</style>
