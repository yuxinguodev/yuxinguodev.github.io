---
// Galette app icon: a rounded-square "mini logo" — cream G with colour dots
// above and slanted colour bars below, on black with a cream inner frame.
interface Props {
	size?: number;
}

const { size = 72 } = Astro.props;
---

<svg class="galette-icon" viewBox="0 0 200 200" width={size} height={size} aria-hidden="true">
	<rect x="10" y="10" width="180" height="180" rx="42" fill="#0a0a0a" />
	<rect x="14" y="14" width="172" height="172" rx="38" fill="none" stroke="#efe8d6" stroke-width="4" />
	<circle cx="104" cy="52" r="7" fill="#ee86ae" />
	<circle cx="122" cy="52" r="7" fill="#f2662a" />
	<circle cx="140" cy="52" r="7" fill="#f8c62e" />
	<circle cx="158" cy="52" r="7" fill="#8d5cc0" />
	<text x="98" y="138" text-anchor="middle" class="g">G</text>
	<g transform="skewX(-22)">
		<rect x="96" y="150" width="10" height="14" rx="2" fill="#3f9152" />
		<rect x="112" y="150" width="16" height="14" rx="2" fill="#4c60d0" />
		<rect x="134" y="150" width="22" height="14" rx="2" fill="#f8c62e" />
		<rect x="162" y="150" width="30" height="14" rx="2" fill="#e2344f" />
	</g>
</svg>

<style>
	.galette-icon {
		display: block;
		flex-shrink: 0;
	}
	.g {
		font-family: var(--font-display), 'Arial Rounded MT Bold', sans-serif;
		font-weight: 700;
		font-size: 104px;
		fill: #efe8d6;
	}
</style>
