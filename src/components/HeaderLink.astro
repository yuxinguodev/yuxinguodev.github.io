---
import type { HTMLAttributes } from 'astro/types';

// One icon button in the header's pill nav. The icon goes in the slot;
// `label` is used for the hover tooltip and for screen readers.
type Props = HTMLAttributes<'a'> & { label: string };

const { href, label, class: className, ...props } = Astro.props;
const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
const subpath = pathname.match(/[^\/]+/g);
const isActive = href === pathname || href === '/' + (subpath?.[0] || '');
---

<a
	href={href}
	class:list={[className, { active: isActive }]}
	aria-label={label}
	aria-current={isActive ? 'page' : undefined}
	{...props}
>
	<slot />
	<span class="tip" aria-hidden="true">{label}</span>
</a>

<style>
	/* Wide, low, round-ended slot inside the glass pill. */
	a {
		position: relative;
		z-index: 1; /* above the hover lens */
		display: flex;
		align-items: center;
		justify-content: center;
		width: 68px;
		height: 40px;
		border-radius: 999px;
		color: rgb(var(--gray));
		text-decoration: none;
		transition: color 0.15s, background 0.2s;
	}
	a:hover,
	a:focus-visible {
		color: rgb(var(--black));
	}
	/* Current page: a faint inner pane of glass. */
	a.active {
		color: rgb(var(--black));
		background: linear-gradient(180deg, rgba(255, 255, 255, 0.14), rgba(255, 255, 255, 0.04));
		box-shadow:
			inset 0 1px 0 rgba(255, 255, 255, 0.25),
			inset 0 -1px 0 rgba(0, 0, 0, 0.25);
	}
	/* --mag is set by the header script for the dock-style magnification. */
	a :global(svg) {
		transform: scale(var(--mag, 1));
		transform-origin: center;
		transition: transform 0.12s ease-out;
	}
	.tip {
		position: absolute;
		top: calc(100% + 10px);
		left: 50%;
		transform: translateX(-50%);
		padding: 6px 8px;
		font-family: var(--font-body);
		font-size: 12px;
		line-height: 1;
		white-space: nowrap;
		color: rgb(var(--black));
		background: var(--surface-raised);
		border: 1px solid var(--border);
		border-radius: 6px;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.15s;
	}
	a:hover .tip,
	a:focus-visible .tip {
		opacity: 1;
	}
</style>
