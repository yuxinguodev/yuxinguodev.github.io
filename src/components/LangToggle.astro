---
// EN / 中文 toggle switch for the Fuzz Pedal page. Swaps every element that
// has a data-zh attribute (and shows/hides [data-lang-block] sections). The
// choice is remembered in localStorage.
---

<div class="lang-toggle">
	<span class="opt en">EN</span>
	<label class="switch">
		<input type="checkbox" aria-label="中文 / English" data-lang-toggle />
		<span class="slider"></span>
	</label>
	<!-- 中文 drawn as outlines from 卓特悦动黑 (SIL OFL), so the 1.8 MB font isn't loaded just for this label. -->
	<span class="opt zh" role="img" aria-label="中文"><svg viewBox="3 -81 158 94" aria-hidden="true"><path fill="currentColor" d="M26.8 10.2L29.5-15.3L19.6-15.3L19.4-13.7L5.1-13.7L5.3-15.3L5.2-15.3L7.4-35.5L10.3-63.9L24.7-63.9L24.5-62.1L34.4-62.1L36-77L52.6-77L51-62.1L61.4-62.1L61.6-63.9L76-63.9L71.8-25L70.8-15.3L70.6-13.7L56.3-13.7L56.5-15.3L46-15.3L43.4 10.2L26.8 10.2ZM20.8-26.3L31.4-26.3L34-51L23.3-51L22.4-42.3L20.8-26.3ZM47-26.3L57.6-26.3L60.2-51L49.6-51L47-26.3ZM80.4 5.1Q97.7-3.6 109.6-16.5L109.6-16.5Q100-33.2 98.9-54.8L98.9-54.8L89.1-54.8L90.3-65.8L119.6-65.8Q114.8-70.4 111.1-73.2L111.1-73.2L114.5-78.6Q120.8-78.2 127-76.3Q133.2-74.4 136.9-71.8L136.9-71.8L132.3-65.8L148.1-65.8L157.9-69.6L157.1-62L156.3-54.8L147.8-54.8Q143.5-33.9 130.3-18L130.3-18Q139.7-10.4 152-5.7L152-5.7L142 11.6Q135.6 9.6 129.2 5.3Q122.8 0.9 117.3-5.4L117.3-5.4Q102.1 6.6 83.2 11.3L83.2 11.3L80.4 5.1ZM107.1-54.8Q110.3-40.6 119.2-29.1L119.2-29.1Q126.7-41 130.3-54.8L130.3-54.8L107.1-54.8Z" /></svg></span>
</div>

<style>
	.lang-toggle {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.7rem;
		margin: 1.5rem 0 0;
		font-weight: 700;
	}
	.opt {
		display: inline-flex;
		font-size: 0.95rem;
		color: #6b6d70;
		transition: color 0.15s;
	}
	.zh svg {
		height: 1.05em;
		width: auto;
	}
	/* highlight whichever language is on */
	.lang-toggle:not(:has(input:checked)) .en,
	.lang-toggle:has(input:checked) .zh {
		color: #e8e8e8;
	}

	/* ---- Toggle switch (from the snippet Yuxin supplied) ---- */
	.switch {
		--switch_width: 2em;
		--switch_height: 1em;
		--thumb_color: #e8e8e8;
		--track_color: #e8e8e8;
		--track_active_color: #888;
		--outline_color: #000;
		font-size: 24px;
		position: relative;
		display: inline-block;
		width: var(--switch_width);
		height: var(--switch_height);
	}
	.switch input {
		opacity: 0;
		width: 0;
		height: 0;
	}
	.slider {
		box-sizing: border-box;
		border: 2px solid var(--outline_color);
		position: absolute;
		cursor: pointer;
		inset: 0;
		background-color: var(--track_color);
		transition: 0.15s;
		border-radius: var(--switch_height);
	}
	.slider::before {
		box-sizing: border-box;
		position: absolute;
		content: '';
		height: var(--switch_height);
		width: var(--switch_height);
		border: 2px solid var(--outline_color);
		border-radius: 100%;
		left: -2px;
		bottom: -2px;
		background-color: var(--thumb_color);
		transform: translateY(-0.2em);
		box-shadow: 0 0.2em 0 var(--outline_color);
		transition: 0.15s;
	}
	input:checked + .slider {
		background-color: var(--track_active_color);
	}
	input:focus-visible + .slider {
		box-shadow: 0 0 0 2px #ff3a6e;
	}
	/* Raise the thumb on hover (the input itself has no size, so hover the label). */
	.switch:hover .slider::before {
		transform: translateY(-0.3em);
		box-shadow: 0 0.3em 0 var(--outline_color);
	}
	input:checked + .slider::before {
		transform: translateX(calc(var(--switch_width) - var(--switch_height))) translateY(-0.2em);
	}
	.switch:hover input:checked + .slider::before {
		transform: translateX(calc(var(--switch_width) - var(--switch_height))) translateY(-0.3em);
		box-shadow: 0 0.3em 0 var(--outline_color);
	}
</style>

<script>
	const KEY = 'fuzz-lang';
	const input = document.querySelector<HTMLInputElement>('[data-lang-toggle]');

	// Swap text between English (original) and Chinese (data-zh).
	const setLang = (lang: 'en' | 'zh') => {
		document.documentElement.dataset.fuzzLang = lang;
		document.querySelectorAll<HTMLElement>('[data-zh]').forEach((el) => {
			if (el.dataset.en === undefined) el.dataset.en = el.textContent ?? '';
			el.textContent = lang === 'zh' ? el.dataset.zh! : el.dataset.en;
		});
		document.dispatchEvent(new CustomEvent('fuzz-lang', { detail: lang }));
		try {
			localStorage.setItem(KEY, lang);
		} catch {}
	};

	if (input) {
		let saved: string | null = null;
		try {
			saved = localStorage.getItem(KEY);
		} catch {}
		if (saved === 'zh') {
			input.checked = true;
			setLang('zh');
		}
		// Checked (thumb right) = 中文, unchecked (thumb left) = EN.
		input.addEventListener('change', () => setLang(input.checked ? 'zh' : 'en'));
	}
</script>
