---
import GooeyNav from './GooeyNav.astro';
import AsciiParticles from './AsciiParticles.astro';
---

<header>
	<a class="site-name" href="/">Isekai Voyage Log</a>

	<GooeyNav
		items={[
			{ label: 'Home', href: '/' },
			{ label: 'Projects', href: '/projects' },
			{ label: 'Articles', href: '/blog' },
			{ label: 'Tools', href: '/tools' },
			{ label: 'About', href: '/about' },
		]}
	/>

	<a class="github" href="https://github.com/yuxinguodev" target="_blank" rel="noopener">
		<span class="sr-only">GitHub</span>
		<svg viewBox="0 0 16 16" aria-hidden="true" width="24" height="24">
			<path
				fill="currentColor"
				d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
			></path>
		</svg>
	</a>
</header>

<!-- Lives here so every page that has the header also gets the background. -->
<AsciiParticles />

<style>
	/* Floats at the top while scrolling; the nav's blurred frame shows content passing under it. */
	header {
		position: sticky;
		top: 0;
		z-index: 20;
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: 1rem;
		max-width: 1100px;
		margin: 0 auto;
		padding: 1rem 1.5rem;
		pointer-events: none; /* only the visible controls take clicks */
		overflow-x: clip; /* the nav canvas has a wide margin; keep it from widening phone pages */
	}
	/* :global so it also reaches child components like GooeyNav (scoped styles would skip them). */
	header > :global(*) {
		pointer-events: auto;
	}
	.site-name {
		font-weight: 700;
		font-size: 17px;
		color: rgb(var(--black));
		text-decoration: none;
		white-space: nowrap;
	}
	.site-name,
	.github {
		transition: opacity 0.25s, visibility 0.25s;
	}
	/* Once scrolled, only the nav stays visible. */
	header.scrolled .site-name,
	header.scrolled .github {
		opacity: 0;
		visibility: hidden;
	}

	.github {
		justify-self: end;
		display: flex;
		color: rgb(var(--gray));
	}
	.github:hover {
		color: rgb(var(--black));
	}
	@media (max-width: 720px) {
		header {
			grid-template-columns: 1fr;
			justify-items: center;
		}
		.site-name,
		.github {
			display: none;
		}
	}
</style>

<script>
	const header = document.querySelector('header');
	// Fade the name and GitHub icon once the page has scrolled.
	const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 40);
	window.addEventListener('scroll', onScroll, { passive: true });
	onScroll();

</script>
