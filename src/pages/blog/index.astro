---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import OrbitShowcase from '../../components/OrbitShowcase.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// One group per category, in this order; empty groups are skipped.
const groups = [
	{ key: 'devlog', title: 'Devlogs', orb: 'nebula', tag: 'Devlog' },
	{ key: 'tutorial', title: 'Tutorials', orb: 'tide', tag: 'Tutorial' },
	{ key: 'essay', title: 'Essays', orb: 'ember', tag: 'Essay' },
] as const;

const orbitItems = posts.map((post) => ({
	href: `/blog/${post.id}/`,
	title: post.data.title,
	image: post.data.heroImage,
}));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Articles | ${SITE_TITLE}`} description="Devlogs, tutorials and course essays." />
	</head>
	<body>
		<Header />
		<main>
			<OrbitShowcase items={orbitItems}>
				<p class="kicker" lang="ja">記事</p>
				<h1 class="page-title">Articles.</h1>
				<p class="page-sub">Devlogs, tutorials and course essays</p>
			</OrbitShowcase>

			{groups.map((group) => {
				const list = posts.filter((post) => post.data.category === group.key);
				if (!list.length) return null;
				return (
					<section>
						<SectionHeading title={group.title} orb={group.orb} />
						<ul class="cards">
							{list.map((post) => (
								<li>
									<a class="card" href={`/blog/${post.id}/`}>
										<span class="cover">
											{post.data.heroImage && <Image src={post.data.heroImage} alt="" width={720} height={450} />}
										</span>
										<span class="card-title">{post.data.title}</span>
										<span class="meta">
											<FormattedDate date={post.data.pubDate} />
											<span class={`cat cat-${group.key}`}>{group.tag}</span>
										</span>
									</a>
								</li>
							))}
						</ul>
					</section>
				);
			})}
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: 960px;
		padding-top: 2rem;
	}
	/* Small Japanese neon label above the title ("articles"). */
	.kicker {
		margin: 0 0 0.35rem;
		font-family: "Hiragino Sans", "Yu Gothic UI", "Yu Gothic", "Meiryo", "Noto Sans JP", sans-serif;
		font-size: 15px;
		font-weight: 700;
		letter-spacing: 0.6em;
		padding-left: 0.6em; /* balance the trailing letter-spacing */
		color: #ff7fe3;
		text-shadow: 0 0 6px rgba(255, 79, 216, 0.9), 0 0 16px rgba(168, 85, 255, 0.6);
	}
	.page-title {
		margin: 0 0 0.25rem;
		font-size: 52px;
	}
	.page-sub {
		margin: 0;
		font-size: 15px;
		color: rgb(var(--gray));
	}
	section {
		margin-bottom: 4rem;
	}

	/* Two-column cards: rounded 16:10 cover, title, date + category tag. */
	.cards {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 2rem 1.5rem;
	}
	.card {
		display: block;
		color: inherit;
		text-decoration: none;
	}
	.cover {
		display: block;
		aspect-ratio: 16 / 10;
		overflow: hidden;
		border-radius: 16px;
		border: 1px solid #1f1f1f;
		background: var(--surface-raised);
		transition: border-color 0.2s;
	}
	.cover :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 0;
		transition: transform 0.4s ease;
	}
	.card:hover .cover {
		border-color: #333;
	}
	.card:hover .cover :global(img) {
		transform: scale(1.04);
	}
	.card-title {
		display: block;
		margin: 0.9rem 0.25rem 0.2rem;
		font-size: 19px;
		font-weight: 700;
		color: rgb(var(--black));
	}
	.meta {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin: 0 0.25rem;
		font-size: 14px;
		color: rgb(var(--gray));
	}

	/* Category tags (same colours as on the homepage). */
	.cat {
		--c: 167, 120, 220;
		padding: 0.1rem 0.55rem;
		font-size: 12px;
		font-weight: 500;
		line-height: 1.4;
		color: rgb(var(--c));
		background: rgba(var(--c), 0.16);
		border: 1px solid rgba(var(--c), 0.45);
		border-radius: 6px;
	}
	.cat-tutorial {
		--c: 110, 132, 240;
	}
	.cat-essay {
		--c: 242, 102, 42;
	}

	@media (max-width: 720px) {
		.page-title {
			font-size: 34px;
		}
		.cards {
			grid-template-columns: 1fr;
		}
	}
</style>
