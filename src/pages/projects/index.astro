---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { SITE_TITLE } from '../../consts';

const projects = (await getCollection('projects')).sort(
	(a, b) => a.data.order - b.data.order
);
const shapes = ['star', 'ring', 'pill', 'wave'] as const;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Projects | ${SITE_TITLE}`} description="Things I have built." />
	</head>
	<body>
		<Header />
		<main>
			<h1>Projects</h1>
			<ul class="project-list">
				{projects.map((project, i) => (
					<li><ProjectCard project={project} shape={shapes[i % shapes.length]} /></li>
				))}
			</ul>
		</main>
		<Footer />
	</body>
</html>

<style>
	main { width: 860px; }
	.project-list { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem 1.5rem; }
	@media (max-width: 720px) { .project-list { grid-template-columns: 1fr; } }
</style>