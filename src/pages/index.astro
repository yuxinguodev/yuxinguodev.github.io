---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { Image } from 'astro:assets';
import FormattedDate from '../components/FormattedDate.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ExperienceTimeline from '../components/ExperienceTimeline.astro';
import { SITE_TITLE, SITE_DESCRIPTION, CONTACT } from '../consts';
import { experience } from '../data/experience';
import { coverAt } from '../data/covers';
import GradientCover from '../components/GradientCover.astro';
import { TOOLS } from '../data/tools';
import ArrowLink from '../components/ArrowLink.astro';
import GaletteIcon from '../components/GaletteIcon.astro';
import { Font } from 'astro:assets';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

// 首页固定展示 4 个项目位：featured 的排前面，再按 order。
// 不足 4 个用 "Coming soon" 补齐；超过 4 个的放在"展开更多项目"里。
const SLOTS = 4;
const ordered = [...projects].sort((a, b) => Number(b.data.featured) - Number(a.data.featured));
const shown = ordered.slice(0, SLOTS);
const extra = ordered.slice(SLOTS);
const placeholders = Math.max(0, SLOTS - shown.length);
// 封面图规则见 src/data/covers.ts（本地有图用图，没有图用随机颜色的颗粒渐变）。

// Shown on each article's category tag.
const CATEGORY_LABELS = { devlog: 'Devlog', tutorial: 'Tutorial', essay: 'Essay' } as const;

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const skills = [
	{ label: 'Languages', items: ['C++', 'C#', 'Python'] },
	{ label: 'Tools', items: ['SFML', 'Unity', 'Git'] },
	{ label: 'Learning', items: ['OpenGL', 'Engine architecture'] },
];

// Hero headline: the greeting is white, each letter of the name gets one
// colour from the rainbow-paper palette. Spaces are non-breaking so each
// character can be its own span for the typing animation.
const greeting = "Hi, I'm ";
const name = 'Yuxin Guo';
const nameColors = ['#ee86ae', '#e2344f', '#f2662a', '#f8c62e', '#3f9152', '#8193c8', '#4c60d0', '#8d5cc0'];
let colorIndex = 0;
const headline = [
	...[...greeting].map((ch) => ({ ch, color: undefined as string | undefined })),
	...[...name].map((ch) => ({ ch, color: ch === ' ' ? undefined : nameColors[colorIndex++] })),
].map(({ ch, color }) => ({ ch: ch === ' ' ? ' ' : ch, color }));

// Empty links are placeholders until filled in src/consts.ts.
const link = (value: string, prefix = '') => (value ? prefix + value : '#');
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<Font cssVariable="--font-display" />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<p class="eyebrow">Game programming student · Auckland, NZ</p>
				<h1 class="typed" aria-label={`${greeting}${name}`}>
					{headline.map(({ ch, color }) => (
						<span class="ch" aria-hidden="true" style={color ? `color:${color}` : undefined}>{ch}</span>
					))}<span class="cursor" aria-hidden="true">_</span>
				</h1>
				<script is:inline>
					// Runs immediately (before paint) so the full name never flashes first.
					// Loop: type the line -> hold -> backspace it -> short pause -> repeat.
					(function () {
						var h = document.currentScript.previousElementSibling;
						if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
						h.classList.add('is-typing');
						var chars = h.querySelectorAll('.ch');
						var HOLD_FULL = 2800; // pause with the whole line shown
						var HOLD_EMPTY = 700; // pause after erasing, before retyping
						var i = 0;
						function type() {
							h.classList.add('busy');
							chars[i].classList.add('shown');
							var ch = chars[i].textContent;
							i++;
							if (i < chars.length) {
								setTimeout(type, ch === ' ' || ch === ',' ? 180 : 80 + Math.random() * 60);
							} else {
								h.classList.remove('busy');
								setTimeout(erase, HOLD_FULL);
							}
						}
						function erase() {
							h.classList.add('busy');
							i--;
							chars[i].classList.remove('shown');
							if (i > 0) {
								setTimeout(erase, 40);
							} else {
								h.classList.remove('busy');
								setTimeout(type, HOLD_EMPTY);
							}
						}
						setTimeout(type, 450);
					})();
				</script>
				<p class="subtitle">I build game systems and simulations in C++.</p>
				<p class="focus">Focus on gameplay programming &amp; emergent gameplay</p>
				<p class="motto">“For the players”</p>
				<div class="contact">
					<a class="btn icon" href={CONTACT.github} target="_blank" rel="noopener" aria-label="GitHub">
						<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 19c-4.3 1.4 -4.3 -2.5 -6 -3m12 5v-3.5c0 -1 .1 -1.4 -.5 -2c2.8 -.3 5.5 -1.4 5.5 -6a4.6 4.6 0 0 0 -1.3 -3.2a4.2 4.2 0 0 0 -.1 -3.2s-1.1 -.3 -3.5 1.3a12.3 12.3 0 0 0 -6.2 0c-2.4 -1.6 -3.5 -1.3 -3.5 -1.3a4.2 4.2 0 0 0 -.1 3.2a4.6 4.6 0 0 0 -1.3 3.2c0 4.6 2.7 5.7 5.5 6c-.6 .6 -.6 1.2 -.5 2v3.5" /></svg>
					</a>
					<a class="btn icon" href={link(CONTACT.linkedin)} target="_blank" rel="noopener" aria-label="LinkedIn">
						<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 11v5" /><path d="M8 8v.01" /><path d="M12 16v-5" /><path d="M16 16v-3a2 2 0 1 0 -4 0" /><path d="M3 7a4 4 0 0 1 4 -4h10a4 4 0 0 1 4 4v10a4 4 0 0 1 -4 4h-10a4 4 0 0 1 -4 -4z" /></svg>
					</a>
					<a class="btn" href={link(CONTACT.email, 'mailto:')}>
						<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z" /><path d="M3 7l9 6l9 -6" /></svg>
						Email me
					</a>
					<a class="btn primary" href={link(CONTACT.resume)} download={CONTACT.resume ? '' : undefined}>
						<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2 -2v-2" /><path d="M7 11l5 5l5 -5" /><path d="M12 4l0 12" /></svg>
						Résumé
					</a>
				</div>
			</section>

			<section>
				<SectionHeading title="Experience" orb="ember" />
				<ExperienceTimeline items={experience} />
			</section>

			<section>
				<SectionHeading title="Projects" orb="rainbow">
					<ArrowLink href="/projects/">All projects</ArrowLink>
				</SectionHeading>
				<ul class="project-grid" id="project-grid">
					{shown.map((project, i) => (
						<li><ProjectCard project={project} image={coverAt(i)} /></li>
					))}
					{Array.from({ length: placeholders }, (_, i) => {
						const n = shown.length + i;
						const img = coverAt(n);
						return (
						<li class="coming-soon">
							<div class="cover">
								{img ? (
									<Image src={img} alt="" width={860} class="cover-img" />
								) : (
									<GradientCover seed={`soon-${n}`} />
								)}
							</div>
							<div class="soon-meta">
								<h3>Coming soon</h3>
								<p>The next project will show up here.</p>
							</div>
						</li>
						);
					})}
					{extra.map((project, i) => (
						<li class="extra" hidden><ProjectCard project={project} image={coverAt(SLOTS + i)} /></li>
					))}
				</ul>
				{extra.length > 0 && (
					<button class="more" type="button" aria-controls="project-grid" aria-expanded="false">
						<span class="more-label">Show more projects</span>
						<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6l6 -6" /></svg>
					</button>
				)}
				<script>
					// "Show more projects": reveal / hide the cards beyond the first four.
					const btn = document.querySelector<HTMLButtonElement>('button.more');
					btn?.addEventListener('click', () => {
						const open = btn.getAttribute('aria-expanded') !== 'true';
						btn.setAttribute('aria-expanded', String(open));
						btn.querySelector('.more-label')!.textContent = open ? 'Show less' : 'Show more projects';
						document.querySelectorAll<HTMLElement>('#project-grid .extra').forEach((el) => (el.hidden = !open));
					});
				</script>
			</section>


			{posts.length > 0 && (
				<section>
					<SectionHeading title="Articles" orb="nebula">
						<ArrowLink href="/blog/">All articles</ArrowLink>
					</SectionHeading>
					<ul class="posts">
						{posts.map((post) => (
							<li>
								<a class="post" href={`/blog/${post.id}/`}>
									<span class="thumb">
										{post.data.heroImage && <Image src={post.data.heroImage} alt="" width={176} height={110} />}
									</span>
									<span class="post-title">{post.data.title}</span>
									<span class={`cat cat-${post.data.category}`}>{CATEGORY_LABELS[post.data.category]}</span>
									<FormattedDate date={post.data.pubDate} />
								</a>
							</li>
						))}
					</ul>
				</section>
			)}

			<section>
				<SectionHeading title="Tools" orb="tide">
					<ArrowLink href="/tools/">All tools</ArrowLink>
				</SectionHeading>
				{/* Four compact app tiles in a row; empty slots say "Coming soon". */}
				<div class="tools">
					{TOOLS.slice(0, 4).map((tool) => (
						<a class="tool" href={tool.href} title={tool.note}>
							<span class="tool-icon">
								{tool.href === '/tools/galette' ? <GaletteIcon /> : <span class="blank"><GradientCover seed={tool.title} /></span>}
							</span>
							<span class="tool-name">{tool.title}</span>
						</a>
					))}
					{Array.from({ length: Math.max(0, 4 - TOOLS.length) }, (_, i) => (
						<div class="tool soon">
							<span class="tool-icon"><span class="blank"><GradientCover seed={`tool-soon-${i}`} /></span></span>
							<span class="tool-name">Coming soon</span>
						</div>
					))}
				</div>
			</section>

			<section>
				<SectionHeading title="Skills" orb="verdant" />
				<div class="skills">
					{skills.map((group) => (
						<div class="skill">
							<p class="skill-label">{group.label}</p>
							<p>{group.items.join(' · ')}</p>
						</div>
					))}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: 860px;
		padding-top: 4.5rem;
	}
	section {
		margin-bottom: 5rem;
	}

	/* Hero */
	.eyebrow {
		margin: 0 0 1rem;
		font-size: 15px;
		color: var(--accent);
	}
	.typed {
		margin: 0 0 1rem;
		font-size: 60px;
		line-height: 1.15;
		letter-spacing: -0.02em;
	}
	/* Untyped characters take no space, so the cursor follows the text. */
	.typed.is-typing .ch {
		display: none;
	}
	.typed.is-typing .ch.shown {
		display: inline;
	}
	.cursor {
		color: #ee86ae;
		animation: blink 1s steps(1) infinite;
	}
	/* Solid cursor while characters are being typed or erased. */
	.typed.busy .cursor {
		animation: none;
	}
	@keyframes blink {
		50% {
			opacity: 0;
		}
	}
	.subtitle {
		margin: 0 0 0.6rem;
		font-size: 26px;
		font-weight: 700;
		line-height: 1.4;
		color: rgb(var(--black));
	}
	.focus {
		margin: 0 0 1.5rem;
		font-size: 17px;
		color: rgb(var(--gray));
	}
	/* Handwritten motto (Homemade Apple). */
	.motto {
		margin: 0.25rem 0 2rem;
		font-family: var(--font-hand);
		font-size: 22px;
		line-height: 1.8;
		color: rgb(var(--gray-dark));
	}
	.contact {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
	}
	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		height: 48px;
		box-sizing: border-box;
		padding: 0 18px 0 16px;
		font-size: 16px;
		font-weight: 500;
		color: rgb(var(--gray-dark));
		text-decoration: none;
		border: 1px solid var(--border);
		border-radius: 12px;
		transition: border-color 0.15s, color 0.15s, background 0.15s;
	}
	.btn.icon {
		width: 48px;
		padding: 0;
	}
	.btn:hover {
		color: rgb(var(--black));
		border-color: rgb(var(--gray));
	}
	.btn.primary {
		color: #000;
		background: rgb(var(--black));
		border-color: rgb(var(--black));
	}
	.btn.primary:hover {
		color: #000;
		background: #fff;
	}
	.btn svg {
		width: 20px;
		height: 20px;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	/* Projects */
	.project-grid {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 2rem 1.5rem;
	}
	.coming-soon .cover {
		display: flex;
		align-items: center;
		justify-content: center;
		aspect-ratio: 16 / 10; /* must match .cover in ProjectCard.astro */
		box-sizing: border-box;
		overflow: hidden;
		border: 1px solid #1f1f1f;
		border-radius: 16px;
	}
	/* Placeholder covers are dimmed so the real project stands out. */
	.coming-soon .cover :global(.gradient-cover) {
		opacity: 0.45;
	}
	.coming-soon .cover :global(.cover-img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		border-radius: 0;
		opacity: 0.45;
		filter: saturate(0.7);
	}
	/* "Show more projects" bar under the grid. */
	.more {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		width: 100%;
		height: 52px;
		margin-top: 2rem;
		font: inherit;
		font-size: 16px;
		font-weight: 500;
		color: rgb(var(--gray-dark));
		text-decoration: none;
		background: transparent;
		border: 1px solid var(--border);
		border-radius: 12px;
		cursor: pointer;
		transition: border-color 0.15s, color 0.15s, background 0.15s;
	}
	.more:hover {
		color: rgb(var(--black));
		border-color: rgb(var(--gray));
		background: var(--surface);
	}
	.more svg {
		width: 20px;
		height: 20px;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
		transition: transform 0.2s;
	}
	.more[aria-expanded='true'] svg {
		transform: rotate(180deg);
	}
	.soon-meta {
		padding: 1rem 0.5rem 0;
	}
	.soon-meta h3 {
		margin: 0;
		font-size: 19px;
		color: rgb(var(--gray));
	}
	.soon-meta p {
		margin: 0;
		font-size: 14px;
		color: rgb(var(--gray));
	}

	/* Skills */
	.skills {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
	}
	.skill {
		padding: 1rem 1.25rem;
		background: var(--surface);
		border-radius: 10px;
	}
	.skill p {
		margin: 0;
		font-size: 16px;
		font-weight: 500;
		color: rgb(var(--black));
	}
	.skill .skill-label {
		margin-bottom: 0.4rem;
		font-size: 14px;
		font-weight: 400;
		color: rgb(var(--gray));
	}

	/* Tool tiles: four big app icons in a row, name underneath, no card behind. */
	.tools {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1.5rem;
	}
	@media (max-width: 720px) {
		.tools {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	.tool {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.6rem;
		text-decoration: none;
	}
	.tool-icon {
		display: block;
		width: 100%;
		aspect-ratio: 1;
		transition: transform 0.3s cubic-bezier(0.3, 0.7, 0.4, 1.4);
	}
	.tool-icon :global(svg) {
		width: 100%;
		height: 100%;
	}
	a.tool:hover .tool-icon {
		transform: translateY(-6px) rotate(-3deg);
	}
	/* Placeholder: a dim gradient squircle matching the real icon's shape and inset. */
	.blank {
		display: block;
		width: 90%;
		height: 90%;
		margin: 5%;
		overflow: hidden;
		border-radius: 23%;
		opacity: 0.45;
		filter: saturate(0.7);
	}
	.tool-name {
		font-size: 15px;
		font-weight: 500;
		color: rgb(var(--black));
	}
	.tool.soon .tool-name {
		color: rgb(var(--gray));
	}

	/* Articles: thumbnail | title | category tag ........ date */
	.posts {
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.posts li {
		border-bottom: 1px solid var(--border);
	}
	.posts li:last-child {
		border-bottom: none;
	}
	.post {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding: 0.9rem 0;
		color: rgb(var(--gray-dark));
		text-decoration: none;
		font-size: 16px;
	}
	.thumb {
		flex-shrink: 0;
		width: 88px;
		height: 55px;
		overflow: hidden;
		border-radius: 10px;
		background: var(--surface-raised);
		border: 1px solid var(--border);
	}
	.thumb :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 0;
		transition: transform 0.3s ease;
	}
	.post:hover .thumb :global(img) {
		transform: scale(1.06);
	}
	.post-title {
		min-width: 0;
		transition: color 0.15s;
	}
	.post:hover .post-title {
		color: rgb(var(--black));
	}
	/* Category tag; colours come from the hero name's palette. */
	.cat {
		--c: 141, 92, 192;
		flex-shrink: 0;
		padding: 0.15rem 0.6rem;
		font-size: 12px;
		font-weight: 500;
		line-height: 1.4;
		color: rgb(var(--c));
		background: rgba(var(--c), 0.16);
		border: 1px solid rgba(var(--c), 0.45);
		border-radius: 6px;
	}
	.cat-devlog {
		--c: 167, 120, 220; /* purple, from the "o" */
	}
	.cat-tutorial {
		--c: 110, 132, 240; /* blue, from the "u" in Guo */
	}
	.cat-essay {
		--c: 242, 102, 42; /* orange, from the "x" */
	}
	.posts :global(time) {
		flex-shrink: 0;
		margin-left: auto;
		font-size: 14px;
		color: rgb(var(--gray));
	}
	@media (max-width: 560px) {
		.thumb {
			width: 64px;
			height: 40px;
		}
		.posts :global(time) {
			display: none;
		}
	}

	@media (max-width: 720px) {
		main {
			padding-top: 2rem;
		}
		.typed {
			font-size: 34px;
		}
		.subtitle {
			font-size: 20px;
		}
		.project-grid,
		.skills {
			grid-template-columns: 1fr;
		}
	}
</style>
