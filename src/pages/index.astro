---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

// 只取 featured: true 的项目，按 order 排序
const featured = (await getCollection('projects'))
	.filter((project) => project.data.featured)
	.sort((a, b) => a.data.order - b.data.order);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>Hi, I'm Ethan.</h1>
				<p class="lead">
					Game programming student in Auckland, working toward engine and
					graphics programming. I build simulations in C++ and write about
					what I learn along the way.
				</p>
				<p class="links">
					<a href="/projects/">See all projects →</a>
					<a href="https://github.com/yuxinguodev" target="_blank" rel="noopener">GitHub</a>
				</p>
			</section>

			<section>
				<h2>Featured projects</h2>
				<ul class="project-list">
					{featured.map((project) => (
						<li><ProjectCard project={project} /></li>
					))}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero { margin-bottom: 3rem; }
	.lead { font-size: 1.25rem; line-height: 1.6; }
	.links { display: flex; gap: 1.5rem; }
	.project-list { list-style: none; padding: 0; display: grid; gap: 2rem; }
</style>